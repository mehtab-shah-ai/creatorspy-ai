{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creatorspy-api",
  "account_id": "e2bbfb3b70eb2a07e0af79c810c47daf",
  "main": "worker.py",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["python_workers"],

  // Cloudflare D1: Permanent Serverless SQLite (Never Wiped)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "creatorspy-db",
      "database_id": "89336379-3a81-4a27-a127-d92d05a528ec"
    }
  ],

  // Cloudflare Vectorize: Permanent Vector DB for Viral Hooks (Never Wiped)
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "creatorspy-hooks"
    }
  ],

  // Environment Secrets / Variables
  "vars": {
    "ENVIRONMENT": "production"
  }
}
