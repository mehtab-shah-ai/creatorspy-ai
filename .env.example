# ==============================================================================
# CreatorSpy AI — Environment Variables Template
# Copy this file to .env and fill in your API keys before running locally.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Security Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="CreatorSpy AI - Autonomous Viral Video Intelligence"
SECRET_KEY="creatorspy-ultra-secret-jwt-key-change-in-production-2026"
ENVIRONMENT="production"
WEB_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 2. Primary & Fallback High-Speed AI LLM Keys (Groq Cloud)
# Get your 100% free API keys at: https://console.groq.com/keys
# (Allows ~14,400 free daily requests with sub-200ms inference)
# ------------------------------------------------------------------------------
GROQ_API_KEY="gsk_your_primary_groq_api_key_here"
GROQ_API_KEY_FALLBACK="gsk_your_backup_groq_api_key_here"

# ------------------------------------------------------------------------------
# 3. Secondary AI LLM Keys (Google Gemini API)
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
# (Used automatically if Groq experiences high traffic)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_primary_gemini_api_key_here"
GEMINI_API_KEY_FALLBACK="your_backup_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 4. YouTube Data API v3 & Search Fallbacks
# Official YouTube API: https://console.cloud.google.com/apis/credentials
# Serper Search Fallback: https://serper.dev/
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY="your_youtube_data_api_v3_key_here"
SERPER_API_KEY="your_serper_search_api_key_here"
SERPER_API_KEY_FALLBACK="your_backup_serper_search_api_key_here"

# ------------------------------------------------------------------------------
# 5. Frontend Backend Connection
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL="https://creatorspy-backend.onrender.com"
